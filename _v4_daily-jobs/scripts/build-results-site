#!/usr/bin/env python3
"""Regenerate the static site's read-only data projection."""

from pathlib import Path

from v4_daily_jobs.site_export import render_site_data


if __name__ == "__main__":
    repository_root = Path(__file__).resolve().parents[1]
    destination = repository_root / "site" / "data.js"
    destination.write_text(render_site_data(repository_root), encoding="utf-8")
    print(destination)
