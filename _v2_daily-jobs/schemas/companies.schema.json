{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-jobs.local/schemas/companies.schema.json",
  "title": "Daily Jobs v2 Company Catalog or Discovery Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "companies"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "companies": {
      "type": "array",
      "items": { "$ref": "#/$defs/company" }
    }
  },
  "$defs": {
    "nullableUri": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "name", "website_url", "primary_domain", "jobs_url", "ats", "map_location", "jobs", "discovered_at", "last_verified_at"],
      "properties": {
        "company_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "website_url": { "$ref": "#/$defs/nullableUri" },
        "primary_domain": { "type": ["string", "null"], "minLength": 1 },
        "jobs_url": { "type": "string", "format": "uri" },
        "ats": { "$ref": "#/$defs/ats" },
        "map_location": { "$ref": "#/$defs/mapLocation" },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/job" }
        },
        "discovered_at": { "type": "string", "format": "date-time" },
        "last_verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "ats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "board_id"],
      "properties": {
        "provider": { "enum": ["ashby", "greenhouse", "lever", "workday", "custom", "unknown"] },
        "board_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "mapLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "region", "country", "address", "postal_code", "latitude", "longitude", "status", "location_type", "source_label", "source_url", "checked_at"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 2 },
        "address": { "type": ["string", "null"], "minLength": 1 },
        "postal_code": { "type": ["string", "null"], "minLength": 1 },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "status": { "enum": ["pending", "located", "not_found"] },
        "location_type": { "enum": ["exact_worksite", "company_office_proxy", null] },
        "source_label": { "type": ["string", "null"], "minLength": 1 },
        "source_url": { "$ref": "#/$defs/nullableUri" },
        "checked_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "address": { "type": "null" },
              "postal_code": { "type": "null" },
              "latitude": { "type": "null" },
              "longitude": { "type": "null" },
              "location_type": { "type": "null" },
              "source_label": { "type": "null" },
              "source_url": { "type": "null" },
              "checked_at": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "located" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "address": { "type": "string", "minLength": 1 },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "location_type": { "enum": ["exact_worksite", "company_office_proxy"] },
              "source_label": { "type": "string", "minLength": 1 },
              "source_url": { "type": "string", "format": "uri" },
              "checked_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "not_found" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "address": { "type": "null" },
              "postal_code": { "type": "null" },
              "latitude": { "type": "null" },
              "longitude": { "type": "null" },
              "location_type": { "type": "null" },
              "source_label": { "type": "null" },
              "source_url": { "type": "null" },
              "checked_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "title", "url", "location_text", "workplace_arrangement", "employment_type", "seniority", "compensation", "posted_date", "status", "verified_at", "evidence"],
      "properties": {
        "job_id": { "type": ["string", "null"], "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "location_text": { "type": "string", "minLength": 1 },
        "workplace_arrangement": { "enum": ["remote", "hybrid", "on-site"] },
        "employment_type": { "type": "string", "minLength": 1 },
        "seniority": { "enum": ["entry-level", "mid-level", "senior", "staff", "principal", "lead", "manager", "director", "executive"] },
        "compensation": { "$ref": "#/$defs/compensation" },
        "posted_date": { "type": ["string", "null"], "format": "date" },
        "status": { "enum": ["active", "inactive"] },
        "verified_at": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "currency", "basis", "period", "source_text"],
      "properties": {
        "minimum": { "type": ["number", "null"], "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3 },
        "basis": { "enum": ["base", "total"] },
        "period": { "enum": ["hour", "month", "year"] },
        "source_text": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_status", "location", "workplace_arrangement", "compensation", "employment_type", "seniority", "role_fit"],
      "properties": {
        "active_status": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "workplace_arrangement": { "type": "string", "minLength": 1 },
        "compensation": { "type": "string", "minLength": 1 },
        "employment_type": { "type": "string", "minLength": 1 },
        "seniority": { "type": "string", "minLength": 1 },
        "role_fit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
