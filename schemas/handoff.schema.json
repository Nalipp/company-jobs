{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v3-daily-jobs.local/schemas/handoff.schema.json",
  "title": "V3 company handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "created_at", "changes", "issues"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "enum": ["company-ingest", "company-validate"] },
    "created_at": { "type": "string", "format": "date-time" },
    "changes": { "type": "array" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "company-ingest" } } },
      "then": {
        "properties": {
          "changes": {
            "items": { "$ref": "#/$defs/ingestCompany" }
          }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "company-validate" } } },
      "then": {
        "properties": {
          "changes": {
            "items": { "$ref": "#/$defs/validationChange" }
          }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "company_id", "subject", "source_url", "details"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "company_id": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "subject": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "source_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "details": { "type": "string", "minLength": 1 }
      }
    },
    "ingestCompany": {
      "allOf": [
        { "$ref": "companies.schema.json#/$defs/company" },
        {
          "properties": {
            "address_status": { "const": "pending" },
            "verified_date": { "type": "null" }
          }
        }
      ]
    },
    "validationChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "expected_status", "address_result"],
      "properties": {
        "company_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "expected_status": { "enum": ["pending", "not_found"] },
        "address_result": { "$ref": "#/$defs/addressResult" }
      }
    },
    "addressResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "latitude",
        "longitude",
        "address_status",
        "address_source_url",
        "address_source_label",
        "verified_date"
      ],
      "properties": {
        "address": {
          "oneOf": [
            { "$ref": "companies.schema.json#/$defs/address" },
            { "type": "null" }
          ]
        },
        "latitude": {
          "oneOf": [
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "null" }
          ]
        },
        "longitude": {
          "oneOf": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "null" }
          ]
        },
        "address_status": { "enum": ["verified", "not_found", "outside_sf"] },
        "address_source_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "address_source_label": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "verified_date": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "address_status": { "const": "not_found" } } },
          "then": {
            "properties": {
              "address": { "type": "null" },
              "latitude": { "type": "null" },
              "longitude": { "type": "null" },
              "address_source_url": { "type": "null" },
              "address_source_label": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "address_status": { "enum": ["verified", "outside_sf"] }
            }
          },
          "then": {
            "properties": {
              "address": {
                "type": "object",
                "properties": {
                  "street": { "type": "string", "minLength": 1 },
                  "city": { "type": "string", "minLength": 1 },
                  "region": { "type": "string", "minLength": 1 },
                  "country": { "type": "string", "minLength": 1 }
                }
              },
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "address_source_url": { "type": "string", "format": "uri" },
              "address_source_label": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}

