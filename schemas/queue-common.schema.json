{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v4-daily-jobs.local/schemas/queue-common.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "batches": {"type": "array", "items": {"$ref": "#/$defs/batch"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "workflow", "model", "limit", "claimed_count", "task_ids", "status", "close_reason", "created_at", "updated_at"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^batch:(validate_companies|find_jobs):.+$"},
        "workflow": {"enum": ["validate_companies", "find_jobs"]},
        "model": {"enum": ["luna", "terra", "sol"]},
        "limit": {"type": "integer", "minimum": 1, "maximum": 75},
        "claimed_count": {"type": "integer", "minimum": 0},
        "task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["active", "limit_reached", "closed"]},
        "close_reason": {"oneOf": [{"enum": ["completed", "queue_empty", "candidate_budget", "stopped", "system_error"]}, {"type": "null"}]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "dedupe_key", "workflow", "status", "expected_model", "priority", "available_at", "created_at", "updated_at", "target", "reason_codes", "policy_version", "target_revision", "context", "attempts", "parent_task_id", "root_task_id", "claim", "resolution"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "dedupe_key": {"type": "string", "minLength": 1},
        "workflow": {"enum": ["validate_companies", "find_jobs"]},
        "status": {"enum": ["open", "running", "completed", "inconclusive", "blocked", "failed"]},
        "expected_model": {"enum": ["luna", "terra", "sol"]},
        "priority": {"type": "integer"},
        "available_at": {"type": "string", "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["company_ids", "source_ids"],
          "properties": {
            "company_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 1},
            "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}},
        "policy_version": {"type": "string", "minLength": 1},
        "target_revision": {"type": "integer", "minimum": 1},
        "context": {"type": "object"},
        "attempts": {"type": "array", "items": {"type": "object"}},
        "parent_task_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "root_task_id": {"type": "string", "minLength": 1},
        "claim": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "resolution": {"oneOf": [{"type": "object"}, {"type": "null"}]}
      }
    }
  }
}
